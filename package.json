{
    "name": "@open-charging-cloud/wwcp-poi",
    "version": "0.1.0",
    "description": "Verifies WWCP POI 3 data in TypeScript: trust anchors, key statements, roaming networks and their ETags, commits, checkpoints, charging station proofs and price statements - so that an EV driver's app knows the charging station and its tariffs it shows are the ones the roaming network signed and published.",
    "keywords": [
        "wwcp",
        "poi",
        "e-mobility",
        "charging-station",
        "charging-tariff",
        "roaming",
        "transparency",
        "merkle-tree",
        "cose",
        "canonical-json",
        "signatures"
    ],
    "homepage": "https://github.com/OpenChargingCloud/WWCP_POI.TS#readme",
    "bugs": {
        "url": "https://github.com/OpenChargingCloud/WWCP_POI.TS/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenChargingCloud/WWCP_POI.TS.git"
    },
    "license": "AGPL-3.0-only",
    "author": "GraphDefined GmbH <achim.friedland@graphdefined.com>",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22.18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run clean && npm run build:js && npm run build:types",
        "build:js": "tsup",
        "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
        "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "test": "npm run test:node && npm run build && npm run test:bundle && npm run test:browser",
        "test:node": "vitest run --config vitest.config.ts",
        "test:bundle": "vitest run --config vitest.bundle.config.ts",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "examples": "tsx examples/validate-examples.ts",
        "verify": "npm run typecheck && npm run lint && npm test && npm run build",
        "prepublishOnly": "npm run verify"
    },
    "dependencies": {
        "@noble/hashes": "^2.4.0",
        "@vanaheimr/cose": "^0.10.0",
        "@vanaheimr/metrological-cbor": "^0.11.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.3",
        "@vitest/browser": "^5.0.5",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "playwright": "^1.64.1",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "esbuild": "^0.28.2"
    }
}
