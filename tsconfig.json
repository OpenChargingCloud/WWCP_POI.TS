{
    "compilerOptions": {
        "target":                        "ES2023",
        "lib":                           ["ES2023"],
        "module":                        "ESNext",
        "moduleResolution":              "Bundler",
        "strict":                        true,
        "noUncheckedIndexedAccess":      true,
        "noImplicitOverride":            true,
        "verbatimModuleSyntax":          true,
        "allowImportingTsExtensions":    true,
        "noEmit":                        true,
        "skipLibCheck":                  true,
        "types":                         ["node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "*.config.ts"]
}
